# Supabase configuration for the Cobalt CRM dashboard.
#
# Copy this file to `.env.local` and fill in the values from your Supabase
# project: Project Settings -> API.
#
#   VITE_SUPABASE_URL              Project URL, e.g. https://abcdefgh.supabase.co
#   VITE_SUPABASE_PUBLISHABLE_KEY  The publishable "anon" key. NEVER use the
#                                  service-role key in the browser — it bypasses
#                                  Row Level Security and anyone loading the
#                                  page could read it.
#
# Both variables are required for database mode. If they are missing or the
# project is unreachable, the app falls back to its local 20-lead demo dataset
# and shows a banner explaining why.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=